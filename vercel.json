{
  "buildCommand": "node tools/build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)\\.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/content/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
